{
  "dataset": "cifar100",
  "data_root": "./data",
  "num_workers": 4,
  "val_size": 0,
  "training": {
    "epochs": 240,
    "batch_size": 64,
    "lr": 0.05,
    "small_model_lr": 0.01,
    "lr_milestones": [
      150,
      180,
      210
    ],
    "lr_decay": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0005
  },
  "kd": {
    "temperature": 4,
    "alpha": 0.9,
    "gamma": 0.1
  },
  "teacher_seed": 0,
  "student_seeds": [
    0,
    1,
    2
  ],
  "pairs": [
    {
      "teacher": "resnet56",
      "student": "resnet20"
    },
    {
      "teacher": "wrn_40_2",
      "student": "wrn_16_2"
    },
    {
      "teacher": "resnet32x4",
      "student": "resnet8x4"
    },
    {
      "teacher": "vgg13",
      "student": "mobilenetv2"
    }
  ],
  "phase1": {
    "pairs": [
      {
        "teacher": "resnet56",
        "student": "resnet20"
      }
    ],
    "modes": [
      "kd_randaugment",
      "kd_cutmix",
      "kd_random_cppn",
      "kd_trained_cppn",
      "kd_evolved_cppn",
      "kd_random_search"
    ]
  },
  "augment": {
    "randaugment": {
      "num_ops": 2,
      "magnitude": 9
    },
    "cutmix": {
      "alpha": 1.0,
      "prob": 0.5
    }
  },
  "views": {
    "neat_config": "configs/neat/cppn_neat.cfg",
    "view_op": "multiplicative",
    "view_scale": 0.5,
    "view_weight": 0.5,
    "view_sampling": "all",
    "probe_batch_size": 256,
    "evolution": {
      "num_generations": 40,
      "top_k": 5,
      "tau_low": 0.5,
      "tau_high": 0.7,
      "gamma": 0.0,
      "contrast_penalty": 0.3,
      "contrast_std_threshold": 0.2,
      "channel_divergence_penalty": 0.3,
      "min_connections": 1,
      "min_pattern_std": 0.01,
      "min_pattern_distance": 0.02
    },
    "random_search": {
      "max_mutations": 40
    },
    "trained": {
      "num_steps": 500,
      "lr": 0.01,
      "temperature": 4,
      "diversity_weight": 1.0,
      "kl_weight": 1.0
    }
  },
  "phase2": {
    "pairs": [
      {
        "teacher": "resnet56",
        "student": "resnet20"
      }
    ],
    "modes": [
      "kd_online_disagree",
      "kd_online_gradalign",
      "kd_online_teacher"
    ]
  },
  "online": {
    "evolve_every": 20,
    "initial_generations": 10,
    "generations_per_round": 5,
    "top_k": 5,
    "view_sampling": "one",
    "pattern_shift": 4,
    "pattern_flip": true,
    "view_weight": 0.5,
    "gate": {
      "tau_low": 0.6,
      "tau_high": 0.9
    }
  },
  "role": "student",
  "arch": "resnet20",
  "mode": "kd_online_disagree",
  "seed": 1,
  "teacher": "resnet56",
  "effective_lr": 0.05,
  "effective_epochs": 240,
  "fake_data": false,
  "max_batches": null
}