# Machine-specific environment activation, sourced by every slurm/*.sbatch
# script in this repo. Copy to cluster_env.sh (gitignored) in the repo root
# and edit for your cluster/project space:
#
#   cp cluster_env.sh.example cluster_env.sh
#
# Keeping this out of the sbatch scripts means moving to a different project
# space (e.g. a new PI allocation) only requires editing this one file.
#
# Before the first sbatch from a fresh clone, also run from the repo root:
#   mkdir -p results/logs   # SLURM opens --output/--error files before the
#                           # job script runs, so the directory must exist
#   (stage the datasets)    # Wulver compute nodes have no internet, so
#                           # torchvision's download=True only works on a
#                           # login node -- see method_paper/README.md
#
# Default: the shared conda env from the DML project on the ikoutis
# allocation (python 3.11, PyPI torch/torchvision wheels bundling the CUDA 12
# runtime -- no cluster CUDA module needed). This repo additionally needs
# `pip install neat-python` in it. Override by exporting CPPN_CONDA_ENV in
# the shell you submit from (sbatch exports your environment by default).
module load Miniforge3
# conda.sh rather than bare `conda activate`: sbatch runs a non-interactive
# shell, where conda's shell function isn't defined yet.
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${CPPN_CONDA_ENV:-/project/ikoutis/conda_env/dml-torch}"

# Alternative: standalone micromamba (comment out the block above instead)
# export MAMBA_ROOT_PREFIX=/project/ikoutis/an57/micromamba
# eval "$(/project/ikoutis/an57/bin/micromamba shell hook -s bash)"
# micromamba activate /project/ikoutis/an57/envs/cppn
